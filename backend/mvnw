#!/bin/sh
set -eu

MVN_VERSION="${MVN_VERSION:-3.9.11}"
BASE_DIR="$(CDPATH= cd "$(dirname "$0")" && pwd)"
WRAPPER_DIR="$BASE_DIR/.mvn/wrapper/dists"
MVN_HOME="$WRAPPER_DIR/apache-maven-$MVN_VERSION"
MVN_ARCHIVE="$WRAPPER_DIR/apache-maven-$MVN_VERSION-bin.tar.gz"
MVN_URL="${MVN_URL:-https://archive.apache.org/dist/maven/maven-3/$MVN_VERSION/binaries/apache-maven-$MVN_VERSION-bin.tar.gz}"

if [ ! -x "$MVN_HOME/bin/mvn" ]; then
  mkdir -p "$WRAPPER_DIR"
  if [ ! -f "$MVN_ARCHIVE" ]; then
    echo "Downloading Apache Maven $MVN_VERSION..."
    curl -fsSL "$MVN_URL" -o "$MVN_ARCHIVE"
  fi
  tar -xzf "$MVN_ARCHIVE" -C "$WRAPPER_DIR"
fi

exec "$MVN_HOME/bin/mvn" "$@"
