<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AMapApiKey</key>
	<string>$(AMAP_API_KEY)</string>
	<!-- 出口合规：本 App 只用系统提供的 HTTPS / Keychain，没有自研或第三方加密实现，
	     属于豁免类。不声明的话每次上传构建都要在 App Store Connect 手工回答一遍。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>iosamap</string>
		<string>baidumap</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>用于通过活体认证 SDK 完成志愿者实人认证。</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>助盲跑在同行服务中需要持续定位，用于共享双方位置并记录本次路线；锁屏后仍会继续定位，可能增加电量消耗。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于将地点描述、路线说明和备注语音转换为文字。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>用于将地点描述、路线说明和备注语音转换为文字。</string>
	<!-- 锁屏实时活动（陪跑中那张卡）。2026-09-16 模拟器 demo 实测：锁屏按钮背后的
	     AudioPlaybackIntent 在 **app 进程**里执行并且能出声，**不需要**给下面的
	     UIBackgroundModes 加 audio —— 删掉该键的对照组同样念出来了（didStart/didFinish 都回调）。
	     所以下面那个数组不要顺手加 audio，那是一条会影响审核的多余后台模式。
	     依据见 docs/research/ios-live-activity-lock-screen-20260916.md -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchScreenBackground</string>
	</dict>
</dict>
</plist>
