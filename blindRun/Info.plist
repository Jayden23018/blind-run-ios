<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AMapApiKey</key>
	<string>$(AMAP_API_KEY)</string>
	<!-- 出口合规：本 App 只用系统提供的 HTTPS / Keychain，没有自研或第三方加密实现，
	     属于豁免类。不声明的话每次上传构建都要在 App Store Connect 手工回答一遍。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>iosamap</string>
		<string>baidumap</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>47.114.113.171</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>用于通过活体认证 SDK 完成志愿者实人认证。</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>助盲跑在同行服务中需要持续定位，用于共享双方位置并记录本次路线；锁屏后仍会继续定位，可能增加电量消耗。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于将地点描述、路线说明和备注语音转换为文字。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>用于将地点描述、路线说明和备注语音转换为文字。</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchScreenBackground</string>
	</dict>
</dict>
</plist>
